use std::cli;
use console;
use petrel;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Admit an immediate charge or report the wait a request can afford.");
        println!("Usage: petrel tokens capacity rate elapsed cost deadline");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = petrel_admit(2.0, 10.0, 2.0, 1.0, 8.0, 2.0);
    } else {
        if count != 6 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let tokens = console_value(args_at(argv, 0));
        let capacity = console_value(args_at(argv, 1));
        let rate = console_value(args_at(argv, 2));
        let elapsed = console_value(args_at(argv, 3));
        let cost = console_value(args_at(argv, 4));
        let deadline = console_value(args_at(argv, 5));
        result = petrel_admit(tokens, capacity, rate, elapsed, cost, deadline);
    }
    if len(result) == 0 { stderr_line("Invalid input for Petrel. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
